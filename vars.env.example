# ==============================================================================
# VARIABLES DE ENTORNO PARA PORTAINER STACK
# Copia y pega este bloque en: Portainer > Stacks > Add stack > Environment variables
# ==============================================================================

# Puerto público en el host (ej. 3000 o 80)
PORT=3000

# URL pública de tu aplicación (para enlaces generados en los emails)
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# FRONTEND: Firebase Web App (Firebase Console > Configuración del Proyecto > General)
# Necesario para el login con Google y autenticación en la interfaz
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_API_BASE=/api

# ------------------------------------------------------------------------------
# BACKEND: Firebase Admin SDK (Firebase Console > Cuentas de servicio > Generar clave)
# Necesario para verificar tokens y sincronizar perfiles en el backend
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# IMPORTANTE: La clave privada puede incluir los \n o pegarse directamente
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# ENVÍO DE CORREOS (Opción recomendada: Gmail con Contraseña de Aplicación)
# Activa 2FA en tu cuenta de Google > Contraseñas de aplicación > Generar
# ------------------------------------------------------------------------------
SMTP_SERVICE=gmail
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_de_16_caracteres
SMTP_FROM=tu_cuenta@gmail.com

# ------------------------------------------------------------------------------
# ENVÍO DE CORREOS ALTERNATIVO (Resend API o SMTP genérico)
# Si prefieres usar Resend, descomenta y pon tu clave API:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Amigo Invisible <onboarding@resend.dev>
# ------------------------------------------------------------------------------
