# ==============================================================
# CONFIGURACIÓN PARA DOCKER & PORTAINER
# ==============================================================

# Puerto en el que responderá la aplicación en tu servidor (ej. 3000 o 80)
PORT=3000

# URL pública con la que accederás a la web (para enlaces en los emails)
APP_URL=http://tu-servidor:3000

# --------------------------------------------------------------
# FRONTEND (Firebase Web App)
# Obtén estos valores en Firebase Console > Configuración del Proyecto
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=amigo-invi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=amigo-invi
VITE_FIREBASE_STORAGE_BUCKET=amigo-invi.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=957582281139
VITE_FIREBASE_APP_ID=1:957582281139:web:5e8cb6d228dd2a1bca23c6
VITE_API_BASE=/api

# --------------------------------------------------------------
# BACKEND (Firebase Admin SDK - Service Account)
# Firebase Console > Configuración del Proyecto > Cuentas de servicio
# --------------------------------------------------------------
FIREBASE_PROJECT_ID=amigo-invi
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@amigo-invi.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------
# CORREO ELECTRÓNICO (SMTP)
# Opcional: Si se omite, los correos se simulan en los logs de Docker
# --------------------------------------------------------------
# Para Gmail: activa 'Contraseñas de aplicación' en tu cuenta de Google
# SMTP_SERVICE=gmail
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# SMTP_FROM=tucorreo@gmail.com

# Para otros servidores SMTP (ej. Mailgun, Sendgrid, hosting propio):
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@ejemplo.com
# SMTP_PASS=secreto
# SMTP_FROM=amigoinvisible@tudominio.com
